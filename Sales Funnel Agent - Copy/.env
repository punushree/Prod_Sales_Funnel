# ─────────────────────────────────────────────
# AOS Agent Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY="your_key"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# Database (SQLite by default; switch to PostgreSQL for production)
DB_ENGINE=django.db.backends.mysql
DB_NAME=aos_db
DB_USER=root
DB_PASSWORD=@Prat850
DB_HOST=localhost
DB_PORT=3306

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# CORS — frontend + n8n origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-dashboard.com

# n8n / Bolna
DJANGO_BASE_URL=https://your-server.com
DASHBOARD_URL=https://your-dashboard.com

# MS Teams
TEAMS_SALES_TEAM_ID=xxxxxxxx-xxxx-xxxx-xxxx
TEAMS_SALES_CHANNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx
TEAMS_SERVICE_TEAM_ID=xxxxxxxx-xxxx-xxxx-xxxx
TEAMS_SERVICE_CHANNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx
TEAMS_DEV_TEAM_ID=xxxxxxxx-xxxx-xxxx-xxxx

# Google Sheets
GSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUq...

# SMS Gateway (MSG91 / Twilio / Fast2SMS)
SMS_GATEWAY_URL=https://api.msg91.com/...
